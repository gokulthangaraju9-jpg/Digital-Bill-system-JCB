{
  "name": "jcb-root",
  "private": true,
  "workspaces": [
    "jcb-platform"
  ],
  "scripts": {
    "dev": "npm run dev --prefix jcb-platform",
    "server": "node jcb-platform/backend/server.js",
    "start": "npm run server & npm run dev",
    "install-all": "npm install --prefix jcb-platform",
    "build": "npm run build --prefix jcb-platform",
    "build-platform": "npm run build --prefix jcb-platform",
    "install-netlify": "npm install --save-dev netlify-cli",
    "netlify-status": "npx netlify status",
    "netlify-login": "npx netlify login",
    "netlify-deploy": "npx netlify deploy --dir=jcb-platform/dist",
    "netlify-prod": "npx netlify deploy --dir=jcb-platform/dist --prod"
  }
}
